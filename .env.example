# Copy to .env. Never commit real values.
STORYFORGE_MODE=demo
STORYFORGE_DATABASE=./storyforge.db
# Replace with a long random value before enabling login.
STORYFORGE_SECRET=replace-with-a-random-32-plus-character-secret
DEMO_ADMIN_PASSWORD=replace-with-a-strong-demo-password
APP_BASE_URL=http://127.0.0.1:8000
# Twitch sign-in redirects to this origin; localhost and 127.0.0.1 have separate cookies.
# Fill in to enable the Twitch login and EventSub connector:
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_BROADCASTER_ID=
# Same value as TWITCH_BROADCASTER_ID for the host's reader token.
TWITCH_READER_ID=
# Generate using: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
TOKEN_ENCRYPTION_KEY=
# Required in live mode; live startup fails if any provider setting is missing.
# Must support /chat/completions with JSON-object response format.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
